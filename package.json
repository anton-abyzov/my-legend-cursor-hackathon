{
  "name": "legend-hyperframes-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "macOS desktop MVP for prompt-directed HyperFrames video assembly.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node src/web/server.js",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "test:e2e": "playwright test",
    "build:quests": "node scripts/buildSideQuests.js",
    "seed:supabase": "node scripts/seedSupabase.js",
    "doctor": "npx --yes hyperframes@0.6.70 doctor",
    "hf:doctor": "npx --yes hyperframes@0.6.70 doctor"
  },
  "build": {
    "appId": "com.legend.hyperframes",
    "productName": "Legend HyperFrames",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/lib-storage": "^3.1062.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@supabase/supabase-js": "^2.107.0",
    "express": "^5.2.1",
    "hyperframes": "^0.6.70",
    "multer": "^2.1.1"
  }
}
