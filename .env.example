PORT=4317
LEGEND_BASE_PATH=/legend

# Supabase Auth + side-quest catalog. When SUPABASE_URL + SUPABASE_ANON_KEY are
# set, the web app uses real Supabase auth (email/password + Google SSO) as the
# primary login. Without them it falls back to the LEGEND_WEB_PASSWORD gate below.
# Without any of these the catalog uses the committed data/side-quests.json.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Google SSO button is shown when Supabase auth is on; set to 0 to hide it.
# LEGEND_GOOGLE_OAUTH=1
LEGEND_DATA_DIR=/opt/legend-sidequests/web-data
LEGEND_WEB_USER=anton
LEGEND_WEB_PASSWORD=change-me
LEGEND_SESSION_SECRET=replace-with-openssl-rand-hex-32
LEGEND_MAX_UPLOAD_MB=750
LEGEND_COOKIE_SECURE=1
LEGEND_STORAGE_PROVIDER=r2
LEGEND_R2_BUCKET=legend-sidequests
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional, only if the R2 bucket has a custom/public domain.
# CLOUDFLARE_R2_PUBLIC_BASE_URL=https://media.example.com

# Quest proof verifier — decides whether the RAW upload actually shows the
# claimed side quest (PASS / FLAG / REJECT). Multimodal: it samples frames from
# the upload and a model looks at them. REQUIRED for real verification; without
# it every proof is FLAGGED for manual review (the badge has no value un-keyed).
LEGEND_GEMINI_API_KEY=your-gemini-api-key
# LEGEND_GEMINI_MODEL=gemini-flash-latest
# Frames sampled across the clip (3-16).
# LEGEND_VERIFIER_FRAMES=8
# Independent passes; PASS/REJECT require agreement across all of them (1-5).
# LEGEND_VERIFIER_PASSES=2
# Averaged confidence needed to auto-accept / auto-reject (0-1).
# LEGEND_VERIFIER_PASS_CONFIDENCE=0.7
# LEGEND_VERIFIER_REJECT_CONFIDENCE=0.6
# Footage older than this many days can only FLAG, never auto-PASS. 0 disables.
# LEGEND_VERIFIER_MAX_AGE_DAYS=0
